{
    auto_https off
}

:8080 {
    handle_path /api/v1/menu* {
        rewrite /api/v1{uri}
        reverse_proxy {$MENU_SERVICE_ADDR} {
            header_up X-Request-Id {uuid}

            health_uri /health
            health_interval 30s
            health_timeout 5s
            health_status 200
        }
    }
}