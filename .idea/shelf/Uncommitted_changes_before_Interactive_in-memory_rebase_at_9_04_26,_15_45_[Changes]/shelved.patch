+func (r *SessionRepository) GetSessions(ctx context.Context, id *uuid.UUID) ([]order.Session, error) {
+	var rows *sql.Rows
+	var err error
+
+	if id == nil {
+		rows, err = r.db.QueryContext(ctx, `SELECT id, table_number, status FROM order_sessions`)
+	} else {
+		rows, err = r.db.QueryContext(ctx, `SELECT id, table_number, status FROM order_sessions WHERE id = $1`, id)
+	}
+	if err != nil {
+		return nil, domain.NewInternalError("error getting order sessions", err)
+	}
+	defer rows.Close()
+
+	sessions := make([]order.Session, 0)
+	for rows.Next() {
+		var sessionId uuid.UUID
+		var tableNumber int
+		var status string
+		err = rows.Scan(&sessionId, &tableNumber, &status)
+		if err != nil {
+			return nil, domain.NewInternalError("error scanning row", err)
+		}
+
+		session, err := order.ParseSession(sessionId, tableNumber, status)
+		if err != nil {
+			return nil, domain.NewInternalError("error parsing session", err)
+		}
+		sessions = append(sessions, *session)
+	}
+
+	return sessions, nil
+}
