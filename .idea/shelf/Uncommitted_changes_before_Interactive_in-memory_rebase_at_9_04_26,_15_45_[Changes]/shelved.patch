<+>package websocket\n\nimport (\n\t\"restaurant/internal/domain/order\"\n\n\t\"github.com/gin-gonic/gin\"\n\t\"github.com/google/uuid\"\n\t\"github.com/gorilla/websocket\"\n)\n\ntype Handler struct {\n\tsessionService order.SessionService\n\tupgrader       websocket.Upgrader\n\n\tsessions map[uuid.UUID]*Session\n\tadmins   map[uuid.UUID]*Admin\n\n\taddSession    chan *Session\n\tremoveSession chan uuid.UUID\n\n\tregister   chan *Admin\n\tunregister chan uuid.UUID\n\n\tbroadcast chan Broadcast\n}\n\nfunc (h *Handler) Pump() {\n\tfor {\n\t\tselect {\n\t\tcase session := <-h.addSession:\n\t\t\th.sessions[session.id] = session\n\t\tcase id := <-h.removeSession:\n\t\t\tdelete(h.sessions, id)\n\n\t\tcase client := <-h.register:\n\t\t\th.admins[client.id] = client\n\t\tcase id := <-h.unregister:\n\t\t\tdelete(h.admins, id)\n\n\t\tcase message := <-h.broadcast:\n\t\t\tif message.SessionId != uuid.Nil {\n\t\t\t\tif broadcast, ok := h.sessions[message.SessionId]; ok {\n\t\t\t\t\tfor _, client := range broadcast.clients {\n\t\t\t\t\t\tselect {\n\t\t\t\t\t\tcase client.send <- message.Message:\n\t\t\t\t\t\tdefault:\n\t\t\t\t\t\t\tdelete(h.sessions, client.id)\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tfor _, admin := range h.admins {\n\t\t\t\tselect {\n\t\t\t\tcase admin.send <- message.Message:\n\t\t\t\tdefault:\n\t\t\t\t\tdelete(h.admins, admin.id)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc NewHandler(service order.SessionService) *Handler {\n\treturn &Handler{\n\t\tsessionService: service,\n\t\tupgrader: websocket.Upgrader{\n\t\t\tReadBufferSize:  1024,\n\t\t\tWriteBufferSize: 1024,\n\t\t},\n\n\t\tsessions: make(map[uuid.UUID]*Session),\n\t\tadmins:   make(map[uuid.UUID]*Admin),\n\n\t\taddSession:    make(chan *Session),\n\t\tremoveSession: make(chan uuid.UUID),\n\n\t\tregister:   make(chan *Admin),\n\t\tunregister: make(chan uuid.UUID),\n\n\t\tbroadcast: make(chan Broadcast),\n\t}\n}\n\nfunc (h *Handler) ConnectAdmin(ctx *gin.Context) {\n\tconn, err := h.upgrader.Upgrade(ctx.Writer, ctx.Request, nil)\n\tif err != nil {\n\t\treturn\n\t}\n\n\tadmin := NewAdmin(uuid.New(), conn, h.sessionService, h.addSession, h.unregister, h.broadcast)\n\th.register <- admin\n\n\tgo admin.ReadPump()\n\tgo admin.WritePump()\n}\n\nfunc (h *Handler) ConnectClient(ctx *gin.Context) {\n\n}\n
