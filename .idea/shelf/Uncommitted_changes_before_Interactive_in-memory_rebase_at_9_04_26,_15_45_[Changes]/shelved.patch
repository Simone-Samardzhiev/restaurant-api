+func (s *DefaultSessionService) IsSessionAvailable(ctx context.Context, id uuid.UUID) error {
+	sessions, err := s.repository.GetSessions(ctx, &id)
+	if err != nil {
+		return err
+	}
+
+	if len(sessions) == 0 || sessions[0].Status.Equals("open") {
+		return domain.NewBadRequestError("cannot connect to session which is not open", domain.ErrorCodeSessionIsNotOpened, nil)
+	}
+
+	return nil
+}
