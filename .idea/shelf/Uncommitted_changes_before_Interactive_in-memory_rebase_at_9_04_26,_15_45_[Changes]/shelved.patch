<+>package order\n\nimport (\n\t\"errors\"\n\t\"restaurant/internal/domain\"\n\n\t\"github.com/google/uuid\"\n)\n\n// SessionTable represents a valid session table.\ntype SessionTable struct {\n\traw int\n}\n\nfunc (s *SessionTable) Value() int {\n\treturn s.raw\n}\n\n// ParseSessionTable parses [SessionTable] from number.\n//\n// If the table is invalid the returned error will be of type [domain.ErrorDetail]\nfunc ParseSessionTable(table int) (SessionTable, error) {\n\tif table < 1 {\n\t\treturn SessionTable{}, &domain.ErrorDetail{\n\t\t\tCode:    domain.ErrorCodeInvalidSessionTable,\n\t\t\tMessage: \"table number must be positive number\",\n\t\t\tMetadata: map[string]any{\n\t\t\t\t\"actual\": table,\n\t\t\t\t\"min\":    1,\n\t\t\t},\n\t\t}\n\t}\n\n\treturn SessionTable{raw: table}, nil\n}\n\n// SessionStatus represents a valid session status.\ntype SessionStatus struct {\n\traw string\n}\n\nfunc (s *SessionStatus) String() string {\n\treturn s.raw\n}\n\n// ParseSessionStatus parses [SessionStatus] from string.\n//\n// If the status is invalid the retuned error will be of type [domain.ErrorDetail].\nfunc ParseSessionStatus(status string) (SessionStatus, error) {\n\tswitch status {\n\tcase \"closed\", \"open\", \"paid\":\n\t\treturn SessionStatus{raw: status}, nil\n\tdefault:\n\t\treturn SessionStatus{}, &domain.ErrorDetail{\n\t\t\tCode:    domain.ErrorCodeInvalidSessionStatus,\n\t\t\tMessage: \"invalid session status\",\n\t\t\tMetadata: map[string]any{\n\t\t\t\t\"actual\":    status,\n\t\t\t\t\"supported\": []string{\"closed\", \"open\", \"paid\"},\n\t\t\t},\n\t\t}\n\t}\n}\n\n// Session represents an order session.\ntype Session struct {\n\tId     uuid.UUID\n\tTable  SessionTable\n\tStatus SessionStatus\n}\n\n// ParseSession parsed [Session] from id, table number and status.\n//\n// If any of the fields is invalid the returned error will be of type [domain.Error].\nfunc ParseSession(id uuid.UUID, table int, status string) (*Session, error) {\n\terrs := make([]domain.ErrorDetail, 0)\n\tparsedTable, err := ParseSessionTable(table)\n\tif err != nil {\n\t\tif errorDetail, ok := errors.AsType[*domain.ErrorDetail](err); ok {\n\t\t\terrs = append(errs, *errorDetail)\n\t\t} else {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\n\tparsedStatus, err := ParseSessionStatus(status)\n\tif err != nil {\n\t\tif errorDetail, ok := errors.AsType[*domain.ErrorDetail](err); ok {\n\t\t\terrs = append(errs, *errorDetail)\n\t\t} else {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\n\tif len(errs) > 0 {\n\t\treturn nil, domain.NewValidationError(\"invalid session\", domain.ErrorCodeInvalidSession, errs...)\n\t}\n\treturn &Session{\n\t\tId:     id,\n\t\tTable:  parsedTable,\n\t\tStatus: parsedStatus,\n\t}, nil\n}\n\n// AddSessionRequest represents a request for adding a session.\ntype AddSessionRequest struct {\n\tTable  SessionTable\n\tStatus SessionStatus\n}\n\n// ParseAddSessionRequest parses [AddSessionRequest] from table number and status.\n//\n// If any of the fields are invalid the returned error will be of type [domain.Error].\nfunc ParseAddSessionRequest(table int, status string) (*AddSessionRequest, error) {\n\terrs := make([]domain.ErrorDetail, 0)\n\tparsedTable, err := ParseSessionTable(table)\n\tif err != nil {\n\t\tif errorDetail, ok := errors.AsType[*domain.ErrorDetail](err); ok {\n\t\t\terrs = append(errs, *errorDetail)\n\t\t} else {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\n\tparsedStatus, err := ParseSessionStatus(status)\n\tif err != nil {\n\t\tif errorDetail, ok := errors.AsType[*domain.ErrorDetail](err); ok {\n\t\t\terrs = append(errs, *errorDetail)\n\t\t} else {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\n\tif len(errs) > 0 {\n\t\treturn nil, domain.NewValidationError(\"invalid session\", domain.ErrorCodeInvalidSession, errs...)\n\t}\n\treturn &AddSessionRequest{\n\t\tTable:  parsedTable,\n\t\tStatus: parsedStatus,\n\t}, nil\n}\n
